+        region.srcOffsets[1].y = src_rect->bottom;
+        region.srcOffsets[1].z = 1;
+        region.dstSubresource.aspectMask = vk_dst_range.aspectMask;
+        region.dstSubresource.mipLevel = vk_dst_range.baseMipLevel;
