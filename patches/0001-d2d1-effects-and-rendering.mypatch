@@ -60,6 +60,53 @@ struct d2d_segment_idx
     size_t control_idx;
 };
 
+enum d2d_segment_type
+{
+    D2D_SEGMENT_TYPE_BEZIERS = 0,
+    D2D_SEGMENT_TYPE_QUADRATIC_BEZIERS,
+    D2D_SEGMENT_TYPE_LINES,
+    D2D_SEGMENT_TYPE_ARCS,
+};
+
+struct d2d_segment
