+    cx0 = fx0 < 0.0 ? 0 : (size_t)fx0;
+    cy0 = fy0 < 0.0 ? 0 : (size_t)fy0;
+    cx1 = fx1 < 0.0 ? 0 : (size_t)fx1;
+    cy1 = fy1 < 0.0 ? 0 : (size_t)fy1;
