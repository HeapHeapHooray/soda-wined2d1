+    d2d_point_set(&arcs[2].point, r->rect.right - r->radiusX, r->rect.bottom);
+    d2d_point_set(&arcs[3].point, r->rect.left, r->rect.bottom - r->radiusY);
+
+    if (transform)
+    {
+        for (int i = 0; i < ARRAYSIZE(points); ++i)
