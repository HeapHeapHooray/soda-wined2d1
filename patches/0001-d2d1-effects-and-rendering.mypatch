+
+    arcs[0].size.width = r->radiusX;
+    arcs[0].size.height = r->radiusY;
+    arcs[0].rotationAngle = 90.0f;
+    arcs[0].sweepDirection = D2D1_SWEEP_DIRECTION_CLOCKWISE;
+    arcs[0].arcSize = D2D1_ARC_SIZE_SMALL;
