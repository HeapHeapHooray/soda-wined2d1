+    d2d_point_set(&points[2], r->rect.right, r->rect.bottom - r->radiusY);
+    d2d_point_set(&points[3], r->rect.left - r->radiusX, r->rect.bottom);
+
+    d2d_point_set(&arcs[0].point, r->rect.left - r->radiusX, r->rect.top);
